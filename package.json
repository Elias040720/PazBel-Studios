    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
