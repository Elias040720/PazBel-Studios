{
  "name": "pazbel-studios",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "PazBel Studios 2.0 — experiencia inmersiva en React, Three.js y GSAP.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
